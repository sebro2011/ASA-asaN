{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:api": "esbuild server/vercelEntry.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=api/index.js",
    "build:models": "node scripts/build-3d-models.mjs",
    "build": "npm run build:api && vite build",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:nova-chat": "node --test scripts/test-nova-chat.mjs",
    "test:earth": "node --import tsx --test scripts/test-earth-intelligence.mjs",
    "test:ai-viewer": "node --import tsx --test scripts/test-ai-earth-viewer.mjs",
    "verify:earth": "node --import tsx scripts/verify-earth-services.mjs",
    "test:earth-server": "node --import tsx --test scripts/test-earth-server.mjs",
    "test:earth-smoke": "node --import tsx scripts/smoke-render.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-sinhala": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@google/model-viewer": "^4.3.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "framer-motion": "^13.4.4",
    "gsap": "^3.15.0",
    "i18next": "^26.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "postprocessing": "^6.39.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-i18next": "^17.0.15",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "three": "^0.186.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
