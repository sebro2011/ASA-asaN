{
  "version": "3.0.0-lk-power",
  "description": "COSMORA AI v3 \u2014 real NASA POWER run, window 2000-01..2024-12, two parameters (T2M, PRECTOTCORR). Derived from config/experiment.json by narrowing the retrieved parameter set and the acquisition window; splits shortened to keep 8 walk-forward folds on the 288 usable months. See docs/FINAL_SCIENTIFIC_AUDIT.md \u00a77.",
  "seeds": [
    7,
    21,
    42,
    84,
    123
  ],
  "locations": [
    {
      "id": "colombo",
      "name": "Colombo",
      "lat": 6.9271,
      "lon": 79.8612,
      "elevation_m": 7,
      "note": "coastal, southwestern monsoon"
    },
    {
      "id": "kandy",
      "name": "Kandy",
      "lat": 7.2906,
      "lon": 80.6337,
      "elevation_m": 500,
      "note": "central highlands, orographic"
    },
    {
      "id": "jaffna",
      "name": "Jaffna",
      "lat": 9.6615,
      "lon": 80.0255,
      "elevation_m": 5,
      "note": "northern, dry zone"
    }
  ],
  "power": {
    "base_url": "https://power.larc.nasa.gov/api/temporal/monthly/point",
    "community": "RE",
    "parameters": {
      "t2m": "T2M",
      "rain": "PRECTOTCORR"
    },
    "start_year": 2000,
    "end_year": 2024,
    "fill_values": [
      -999,
      -999.0,
      -9999,
      -9999.0
    ],
    "timeout_seconds": 45,
    "cache_dir": "data/cache"
  },
  "targets": {
    "temp": {
      "column": "t2m",
      "unit": "degC",
      "label": "2 m air temperature"
    },
    "rain": {
      "column": "rain",
      "unit": "mm/day",
      "label": "precipitation rate"
    }
  },
  "features": {
    "lookback_months": 12,
    "lags": [
      1,
      2,
      3,
      6,
      12
    ],
    "rolling_windows": [
      3,
      6,
      12
    ],
    "include_calendar": true,
    "include_time_index": true
  },
  "splits": {
    "cv_initial_train_months": 120,
    "cv_validation_months": 24,
    "cv_step_months": 12,
    "test_months": 60
  },
  "models": {
    "mlp": {
      "hidden": [
        32,
        16
      ],
      "epochs": 300,
      "batch_size": 32,
      "lr": 0.005,
      "weight_decay": 0.0001,
      "patience": 40
    },
    "gru": {
      "hidden": 24,
      "epochs": 300,
      "batch_size": 32,
      "lr": 0.005,
      "weight_decay": 0.0001,
      "patience": 40
    },
    "lstm": {
      "hidden": 24,
      "epochs": 300,
      "batch_size": 32,
      "lr": 0.005,
      "weight_decay": 0.0001,
      "patience": 40
    },
    "xgboost": {
      "n_estimators": 400,
      "max_depth": 3,
      "learning_rate": 0.05,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "min_child_weight": 3,
      "reg_lambda": 1.0
    },
    "ensemble": {
      "members": [
        "gru",
        "lstm",
        "mlp"
      ],
      "weighting": "equal"
    }
  },
  "uncertainty": {
    "alpha": 0.1,
    "method": "split_conformal",
    "report_gaussian_baseline": true
  },
  "extreme": {
    "quantile": 0.95,
    "min_train_months": 120
  },
  "evaluation": {
    "bootstrap_resamples": 5000,
    "bootstrap_seed": 20241101,
    "dm_max_lag": 6,
    "primary_metric": "mae"
  },
  "output": {
    "results_dir": "results",
    "figures": true,
    "html_dashboard": true
  },
  "derivation": {
    "from": "config/experiment.json",
    "changes": [
      "power.parameters: 5 -> 2 (only T2M and PRECTOTCORR were retrieved)",
      "power window: 1985-2025 -> 2000-2024 (POWER MERRA2 payload actually transcribed)",
      "splits.cv_initial_train_months: 180 -> 120 (288 usable months; keeps 8 folds)",
      "sealed 60-month test tail and every other setting unchanged"
    ]
  }
}
