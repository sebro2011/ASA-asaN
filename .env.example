# Server-only API keys for NOVA text chat and related Gemini services.
# Keep these keys out of VITE_* variables and frontend code.
# NOVA Auto uses OpenRouter first, then Gemini, and falls back to the bundled local space engine.
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""

# Optional model overrides for NOVA. Defaults: gemini-2.5-flash and openrouter/free.
NOVA_GEMINI_MODEL="gemini-2.5-flash"
NOVA_OPENROUTER_MODEL="openrouter/free"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and OpenRouter attribution.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_NASA_API_KEY: Optional NASA Open API key (defaults to 'DEMO_KEY' if not provided).
# Obtain a free official key at https://api.nasa.gov
NEXT_PUBLIC_NASA_API_KEY="DEMO_KEY"
NASA_API_KEY="DEMO_KEY"

# FIRMS_MAP_KEY: Optional. NASA FIRMS area API key (free, https://firms.modaps.eosdis.nasa.gov/api/).
# When set, the Earth Intelligence Lab can report real hotspot detection counts for a
# bounding box. When it is absent, the Lab states that hotspot counts are unavailable —
# it never estimates them.
FIRMS_MAP_KEY=""

# Optional server-only YouTube Data API v3 key. Enable YouTube Data API v3 in Google Cloud.
# Without it, CosmoVision uses a small, clearly labelled curated collection. Never use VITE_*.
YOUTUBE_API_KEY=""

# Optional CosmoVision community submissions. Configure ALL three on the server
# only after running supabase/cosmovision.sql and setting up Supabase Auth.
# SUPABASE_PUBLISHABLE_KEY (or the legacy anon key) is deliberately public and
# is returned to the browser for sign-in; it must NEVER be a service/secret key.
# SUPABASE_SERVICE_ROLE_KEY is privileged: keep it server-only, never use VITE_*,
# commit it, print it, or send it to the browser.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
