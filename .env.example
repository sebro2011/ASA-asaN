# Server-only API keys for NOVA text chat and related AI services.
# Keep these keys out of VITE_* variables and frontend code.
# NOVA Auto prefers Arena when configured, then OpenRouter, then Gemini,
# and falls back to the bundled local space engine.
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
# Arena AI API key (arena-sk-...). Obtain from your Arena IA instance at
# Administration → API Keys. The exact base URL is shown on the key creation screen.
ARENA_API_KEY=""

# Optional model overrides for NOVA. Defaults: gemini-3.8-flash, openrouter/free,
# and arena_smart.aria for Arena AI.
NOVA_GEMINI_MODEL="gemini-3.8-flash"
NOVA_OPENROUTER_MODEL="openrouter/free"
NOVA_ARENA_MODEL="arena_smart.aria"

# Optional Arena AI base URL. Defaults to https://api.arena.ai/v1/chat/completions.
# Set this to your Arena instance's chat completions endpoint if different.
ARENA_BASE_URL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and OpenRouter attribution.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_NASA_API_KEY: Optional NASA Open API key (defaults to 'DEMO_KEY' if not provided).
# Obtain a free official key at https://api.nasa.gov
NEXT_PUBLIC_NASA_API_KEY="DEMO_KEY"
NASA_API_KEY="DEMO_KEY"

# FIRMS_MAP_KEY: Optional. NASA FIRMS area API key (free, https://firms.modaps.eosdis.nasa.gov/api/).
# When set, the Earth Intelligence Lab can report real hotspot detection counts for a
# bounding box. When it is absent, the Lab states that hotspot counts are unavailable —
# it never estimates them.
FIRMS_MAP_KEY=""

# Optional server-only YouTube Data API v3 key. Enable YouTube Data API v3 in Google Cloud.
# Without it, CosmoVision uses a small, clearly labelled curated collection. Never use VITE_*.
YOUTUBE_API_KEY=""

# Optional CosmoVision community submissions. Configure ALL three on the server
# only after running supabase/cosmovision.sql and setting up Supabase Auth.
# SUPABASE_PUBLISHABLE_KEY (or the legacy anon key) is deliberately public and
# is returned to the browser for sign-in; it must NEVER be a service/secret key.
# SUPABASE_SERVICE_ROLE_KEY is privileged: keep it server-only, never use VITE_*,
# commit it, print it, or send it to the browser.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Server runtime (all optional; the defaults are correct for local development)
# ---------------------------------------------------------------------------
# PORT: the port `npm run dev` / `npm start` listens on. Default 3000.
PORT="3000"
# NODE_ENV: "production" enables the strict CSP, HSTS and the CORS allow-list.
# Anything else is treated as development, where any origin is echoed back.
NODE_ENV="development"
# CORS_ORIGINS: comma-separated extra origins allowed to call the API
# (e.g. "https://nova.example.com,https://preview.example.com"). Same-origin
# requests and the Vercel preview/production hostnames are always allowed, so
# this only needs entries for genuinely third-party front ends.
CORS_ORIGINS=""
# DISABLE_HMR=1 turns off Vite HMR (used by the smoke-render script).
DISABLE_HMR=""

# ---------------------------------------------------------------------------
# Platform-provided (Vercel injects these; listed so nobody sets them by hand)
# ---------------------------------------------------------------------------
# VERCEL_ENV=""            # production | preview | development
# VERCEL_URL=""            # per-deployment hostname, e.g. nova-abc123.vercel.app
# VERCEL_BRANCH_URL=""     # stable hostname for the branch
# VERCEL_PROJECT_PRODUCTION_URL=""  # the production hostname
# VERCEL_GIT_COMMIT_SHA="" # shown by /api/nova/diagnostics
# VERCEL_GIT_COMMIT_REF="" # branch name, also shown by diagnostics

# SUPABASE_ANON_KEY is the legacy name for the same public key as
# SUPABASE_PUBLISHABLE_KEY; set one or the other, never both.
SUPABASE_ANON_KEY=""
