# Server-only API keys for NOVA text chat and related AI services.
# Keep these keys out of VITE_* variables and frontend code.
# NOVA Auto prefers Arena when configured, then OpenRouter, then Gemini,
# and falls back to the bundled local space engine.
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
# Arena AI API key (arena-sk-...). Obtain from your Arena IA instance at
# Administration → API Keys. The exact base URL is shown on the key creation screen.
ARENA_API_KEY=""

# Optional model overrides for NOVA. Defaults: gemini-3.8-flash, openrouter/free,
# and arena_smart.aria for Arena AI.
NOVA_GEMINI_MODEL="gemini-3.8-flash"
NOVA_OPENROUTER_MODEL="openrouter/free"
NOVA_ARENA_MODEL="arena_smart.aria"

# Thinking ladder (auto → flash → flash-thinking → thinking → deep-thinking).
# The four explicit levels map onto OpenRouter's `reasoning.effort`
# (low / medium / high) plus a token budget. Each level may pin a different
# OpenRouter model — e.g. a thinking-capable variant for "flash thinking" while
# "flash" stays cheap. Leave blank to use NOVA_OPENROUTER_MODEL for that level.
NOVA_OPENROUTER_FLASH_MODEL=""
NOVA_OPENROUTER_FLASH_THINKING_MODEL=""
NOVA_OPENROUTER_THINKING_MODEL=""
NOVA_OPENROUTER_DEEP_THINKING_MODEL=""

# Optional Arena AI base URL. Defaults to https://api.arena.ai/v1/chat/completions.
# Set this to your Arena instance's chat completions endpoint if different.
ARENA_BASE_URL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and OpenRouter attribution.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_NASA_API_KEY: Optional NASA Open API key (defaults to 'DEMO_KEY' if not provided).
# Obtain a free official key at https://api.nasa.gov
NEXT_PUBLIC_NASA_API_KEY="DEMO_KEY"
NASA_API_KEY="DEMO_KEY"

# FIRMS_MAP_KEY: Optional. NASA FIRMS area API key (free, https://firms.modaps.eosdis.nasa.gov/api/).
# When set, the Earth Intelligence Lab can report real hotspot detection counts for a
# bounding box. When it is absent, the Lab states that hotspot counts are unavailable —
# it never estimates them.
FIRMS_MAP_KEY=""

# ---------------------------------------------------------------------------
# Space news & astronomy papers (workspace → Space News at /news)
# ---------------------------------------------------------------------------
# Every key here is server-only: the browser is told whether a source is
# configured, never the key. Spaceflight News and arXiv need no key, so the
# news surface works out of the box; the rest add coverage when set.
# Spaceflight News API v4 — free, no key. https://api.spaceflightnewsapi.net/v4/docs/
# GNews — https://gnews.io/ (free tier). Server-side search for astronomy news.
GNEWS_API_KEY=""
# NewsAPI.org — https://newsapi.org/register. The key is sent as X-Api-Key.
NEWSAPI_KEY=""
# The Guardian Open Platform — https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=""

# Optional server-only YouTube Data API v3 key. Enable YouTube Data API v3 in Google Cloud.
# Without it, CosmoVision uses a small, clearly labelled curated collection. Never use VITE_*.
YOUTUBE_API_KEY=""

# Optional CosmoVision community submissions. Configure ALL three on the server
# only after running supabase/cosmovision.sql and setting up Supabase Auth.
# SUPABASE_PUBLISHABLE_KEY (or the legacy anon key) is deliberately public and
# is returned to the browser for sign-in; it must NEVER be a service/secret key.
# SUPABASE_SERVICE_ROLE_KEY is privileged: keep it server-only, never use VITE_*,
# commit it, print it, or send it to the browser.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Server runtime (all optional; the defaults are correct for local development)
# ---------------------------------------------------------------------------
# PORT: the port `npm run dev` / `npm start` listens on. Default 3000.
PORT="3000"
# NODE_ENV: "production" enables the strict CSP, HSTS and the CORS allow-list.
# Anything else is treated as development, where any origin is echoed back.
NODE_ENV="development"

# ---------------------------------------------------------------------------
# Proxy trust — how many proxies sit in front of this deployment.
#
# Unset defaults to 1 (one platform proxy hop, which is what Vercel and Cloud
# Run provide). With 0 proxies the app trusts nothing; set the real number if
# you add another layer, or every per-IP rate limit collapses into a single
# shared bucket (and `req.ip` becomes the proxy's address for everyone).
#
# TRUST_PROXY="1"
# CORS_ORIGINS: comma-separated extra origins allowed to call the API
# (e.g. "https://nova.example.com,https://preview.example.com"). Same-origin
# requests and the Vercel preview/production hostnames are always allowed, so
# this only needs entries for genuinely third-party front ends.
CORS_ORIGINS=""
# DISABLE_HMR=1 turns off Vite HMR (used by the smoke-render script).
DISABLE_HMR=""

# ---------------------------------------------------------------------------
# Platform-provided (Vercel injects these; listed so nobody sets them by hand)
# ---------------------------------------------------------------------------
# VERCEL_ENV=""            # production | preview | development
# VERCEL_URL=""            # per-deployment hostname, e.g. nova-abc123.vercel.app
# VERCEL_BRANCH_URL=""     # stable hostname for the branch
# VERCEL_PROJECT_PRODUCTION_URL=""  # the production hostname
# VERCEL_GIT_COMMIT_SHA="" # shown by /api/nova/diagnostics
# VERCEL_GIT_COMMIT_REF="" # branch name, also shown by diagnostics

# ---------------------------------------------------------------------------
# COSMORA API Guardian — dependency diagnostics at /guardian
# ---------------------------------------------------------------------------
# Read routes (/api/guardian/status, /health, /providers) need nothing.
# Every ACTION route needs GUARDIAN_ADMIN_TOKEN, and fails closed without it.
# GUARDIAN_ADMIN_TOKEN: long random string the operator types into the dashboard.
# It is never stored by the browser and never put in a URL.
GUARDIAN_ADMIN_TOKEN=""
# CRON_SECRET: bearer secret for GET /api/guardian/cron. Vercel sends it
# automatically when the variable exists; any external scheduler can send it too.
CRON_SECRET=""

# Fleet-wide state (circuit breakers, budgets, the sweep lease). Without these the
# guardian runs on in-process memory: correct for one instance, no fleet
# guarantees — and the dashboard says so instead of implying otherwise.
# Use the shared Supabase project (Postgres) to get real fleet behaviour, after
# applying supabase/migrations/20261112000000_guardian.sql.
GUARDIAN_STORE_URL=""          # https PostgREST base; defaults to SUPABASE_URL
GUARDIAN_STORE_KEY=""          # MUST be a service-role key; a publishable key is rejected
GUARDIAN_NAMESPACE=""          # table prefix namespace, default "cosmora"
GUARDIAN_PROBE_LIMIT=""        # optional cap on probes per sweep

# ---------------------------------------------------------------------------
# NOVA NEXUS / L.I.F.E. — local-first engine (sandboxed by default)
# ---------------------------------------------------------------------------
# NOVA_LIFE_ALLOW_EXECUTE: 1 enables shell execution inside the L.I.F.E. sandbox.
# Leave empty in production: the engine then refuses every command.
NOVA_LIFE_ALLOW_EXECUTE=""
# NOVA_LIFE_DB: path to the SQLite file. Defaults to .nova-life/ under the repo.
NOVA_LIFE_DB=""

# ---------------------------------------------------------------------------
# Optional model overrides for the Earth Analyst and Forge assistants.
# Each falls back to the corresponding NOVA model when unset.
# ---------------------------------------------------------------------------
NOVA_ANALYST_MODEL=""
EARTH_ANALYST_OPENROUTER_MODEL=""
EARTH_ANALYST_ARENA_MODEL=""
FORGE_ASSISTANT_OPENROUTER_MODEL=""
FORGE_ASSISTANT_ARENA_MODEL=""

# SUPABASE_ANON_KEY is the legacy name for the same public key as
# SUPABASE_PUBLISHABLE_KEY; set one or the other, never both.
SUPABASE_ANON_KEY=""
